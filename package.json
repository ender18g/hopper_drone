{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && node scripts/write-offline-manifest.mjs",
    "build:student": "vite build --config vite.standalone.config.ts",
    "build:pages": "npm run build:student && node scripts/prepare-pages.mjs",
    "build:desktop": "npm run build:student && node scripts/prepare-desktop.mjs && npm run test:desktop",
    "build:all": "npm run build && npm run build:student",
    "desktop:dev": "npm run build:desktop && electron desktop/main.mjs",
    "package:mac": "npm run build:desktop && electron-builder --projectDir desktop --config electron-builder.config.cjs --mac",
    "package:win": "npm run build:desktop && electron-builder --projectDir desktop --config electron-builder.config.cjs --win",
    "start": "vinext start",
    "test": "npm run build:all && node --test tests/*.test.mjs",
    "test:desktop": "node --test tests/desktop-server.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@teachablemachine/image": "^0.8.5",
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow/tfjs": "^4.22.0",
    "apriltag": "^2.0.3",
    "blockly": "^13.1.1",
    "drizzle-orm": "0.45.2",
    "next": "^16.2.11",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@electron/fuses": "^2.0.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "plist": "^3.1.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.3"
    }
  },
  "type": "module"
}
